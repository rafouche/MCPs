{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "m365-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // On-call alerting for HelpDeskAgent's escalate_emergency (v2.13.0). Plain
  // vars, not secrets: these are the same on-call contacts HelpDeskAgent's
  // config.json already carries. Change them here and `npm run deploy`.
  "vars": {
    "ON_CALL_SENDER": "help@altecusa.com",
    "ON_CALL_RECIPIENTS": "roger@altecusa.com,4178300075@vtext.com",
    "ON_CALL_TENANT": "altec"
  },
  // Secrets (wrangler secret put — do NOT put values here):
  //   M365_CLIENT_ID      — App registration client ID from Azure portal
  //   M365_CLIENT_SECRET  — App registration client secret (shown once)
  //   M365_TENANTS        — JSON object: {"altec":"tenant-id-guid","goldmechanical":"tenant-id-guid"}
  // A deploy keeps variables set in the Cloudflare dashboard instead of
  // replacing them (a token entered as plain text there must not be wiped).
  "keep_vars": true
}
