{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hudu-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Secrets (never in this file): HUDU_API_KEY (Hudu > Admin > API Keys) and
  // MCP_AUTH_TOKEN (the Bearer token the MCP client registration sends).
  // Unlike the other Workers, /mcp refuses every call until MCP_AUTH_TOKEN
  // is set - Hudu is the client documentation store.
  "vars": { "HUDU_BASE_URL": "https://altecusa.huducloud.com" },
  // Safety net: a deploy normally replaces every plain-text variable set in
  // the dashboard with the ones above. HUDU_API_KEY was entered as plain
  // text (2026-09-25 check) and would have been wiped by the next deploy.
  // Keep it as a Secret; this line only protects against the mistake.
  "keep_vars": true
}
