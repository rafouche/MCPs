{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ninjarmm-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // User-context OAuth tokens (refresh token + cached access token) for
  // running scripts - see the Env comment in src/index.ts. Namespace created
  // 2026-09-22 with `wrangler kv namespace create NINJA_TOKENS`.
  "kv_namespaces": [
    { "binding": "NINJA_TOKENS", "id": "67d6fba4a3b04ab7a13c1154b9cf8e56" }
  ],
  // A deploy keeps variables set in the Cloudflare dashboard instead of
  // replacing them (a token entered as plain text there must not be wiped).
  "keep_vars": true
}